# Protect the web app when it is reachable from the internet.
APP_ACCESS_KEY=change-this-secret

# Must be true before Test Send / Live Send can send email.
EMAIL_SEND_ENABLED=false

# Gmail SMTP (recommended for the central mailbox account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-central-mail@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-central-mail@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Maximum estimated MIME size to keep as direct attachments.
# Files above this threshold are moved to Google Drive links automatically.
DIRECT_ATTACHMENT_MAX_MB=20

# Google Drive fallback for oversized files.
# Keep false until OAuth credentials are configured.
DRIVE_FALLBACK_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# anyone_with_link is the most reliable option for external recipients.
# Anyone who has the URL can open/download the file, so use a dedicated folder.
GOOGLE_DRIVE_SHARE_MODE=anyone_with_link
