# Protect the web app when it is reachable from the internet.
APP_ACCESS_KEY=change-this-secret

# Must be true before Test Send / Live Send can send email.
EMAIL_SEND_ENABLED=false

# Gmail SMTP (central mailbox). Use a Google App Password, not the normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-central-mail@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-central-mail@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Gmail Inbox watcher. Keep disabled until the mailbox credentials and real To/CC are ready.
# INBOX_USERNAME/PASSWORD may use the same central Gmail + App Password as SMTP.
INBOX_WATCH_ENABLED=false
INBOX_HOST=imap.gmail.com
INBOX_PORT=993
INBOX_USERNAME=your-central-mail@gmail.com
INBOX_PASSWORD=your-google-app-password
INBOX_FOLDER=INBOX
INBOX_POLL_SECONDS=60
INBOX_SCAN_LIMIT=200
INBOX_MAX_REPORT_AGE_DAYS=3
# Strongly recommended: exact company sender address(es), comma separated.
INBOX_ALLOWED_SENDERS=

# Maximum estimated MIME size to keep as direct attachments.
# If one email group is above this threshold, ALL files in that email become Drive links.
DIRECT_ATTACHMENT_MAX_MB=20

# Google Drive fallback for oversized email groups.
# Keep false until OAuth credentials are configured.
DRIVE_FALLBACK_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# anyone_with_link is the most reliable option for external recipients.
# Anyone who has the URL can open/download the file, so use a dedicated folder.
GOOGLE_DRIVE_SHARE_MODE=anyone_with_link
