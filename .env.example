# Protect the web app when it is reachable from the internet.
APP_ACCESS_KEY=change-this-secret

# Must be true before Run & Send Emails can send real email.
EMAIL_SEND_ENABLED=false

# Generic SMTP settings.
# Gmail example: smtp.gmail.com / 587 / TLS=true (use an App Password)
# Outlook.com example: smtp-mail.outlook.com / 587 / TLS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-personal-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-personal-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
